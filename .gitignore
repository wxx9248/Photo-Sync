# Rust
/desktop/target/
**/*.rs.bk

# Gradle / Android
/android/.gradle/
/android/build/
/android/**/build/
/android/local.properties
/android/.idea/
*.apk
*.aab

# Generated protobuf sources are never committed
/desktop/**/generated/
/android/**/generated/

# Harness output
/verification/reports/*.json
/verification/reports/traces/
/desktop/mutants.out/
/desktop/mutants.out.old/

# Editors and OS
.idea/
.vscode/
*.swp

# Android build output and local SDK pointers. A JVM that runs out of metaspace leaves an
# 800 MB heap dump beside the build; it is never wanted, and GitHub refuses it outright.
*.hprof
android/.gradle/
android/build/
android/*/build/
android/local.properties
